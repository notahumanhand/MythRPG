@page "/trait/edit/{TraitId:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager NavigationManager
@inject ITraitsRepository TraitsRepository
@inject IClassesRepository ClassesRepository

<PageTitle>Mythmaven: Edit Trait</PageTitle>

@if (trait is not null) 
{
    <div class="form-group">
        <label for="name">Trait Name</label>
        <input type="text" id="name" @bind="trait.Name" class="form-control"></input>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label for="source">Source</label>
                <input type="text" id="source" @bind="trait.Source" class="form-control"></input>
            </div>
        </div>
        <div class="col-md-4">
        </div>
    </div>
    <div class="form-group mt-3">
        <h5>Eligible Classes</h5>

        <p>
            Leave all classes unchecked to make this trait available to all classes.
        </p>

        @foreach (var characterClass in classes)
        {
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input"
                       checked="@IsClassSelected(characterClass.CharacterClassId)"
                       @onchange="@(e => ToggleClass(characterClass.CharacterClassId, e.Value))" />

                <label class="form-check-label">
                    @characterClass.Name
                </label>
            </div>
        }

    </div>
    <div class="form-group">
        <label for="desc">Description</label>
        <input type="textarea" id="desc" @bind="trait.Description" class="form-control"></input>
    </div>
}
@if (confirmText)
{
    <p>Changes saved! <button type="button" class="btn btn-danger" @onclick="ClearAlert">X</button></p>
}
<button type="button" class="btn btn-success" @onclick="Update">Save Changes</button>
<a class="btn btn-primary" href="/traits">Return to Traits</a>

@code {
    [Parameter]
    public int TraitId { get; set; }

    private Trait trait = new Trait
        {
            Name = string.Empty,
            Rank = 0
        };

    private bool confirmText = false;

    private List<CharacterClass> classes = new();

    private List<int> selectedClassIds = new();

    protected override void OnParametersSet()
    {
        Trait? trytrait = TraitsRepository.GetTraitById(TraitId);

        if (trytrait is null)
        {
            NavigationManager.NavigateTo("/traits");
            return;
        } 
        trait = trytrait;

        classes = ClassesRepository.GetClasses();

        selectedClassIds = trait.EligibleClasses.Select(c => c.CharacterClassId).ToList();
    }

    private bool IsClassSelected(int classId)
    {
        return selectedClassIds.Contains(classId);
    }

    private void ToggleClass(int classId, object? value)
    {
        bool selected = bool.TryParse(value?.ToString(), out bool result) && result;

        if (selected)
        {
            if (!selectedClassIds.Contains(classId))
            {
                selectedClassIds.Add(classId);
            }
        }
        else
        {
            selectedClassIds.Remove(classId);
        }
    }

    void Update()
    {
        TraitsRepository.UpdateTrait(TraitId, trait, selectedClassIds);
        confirmText = true;
    }

    void ClearAlert()
    {
        confirmText = false;
    }

}