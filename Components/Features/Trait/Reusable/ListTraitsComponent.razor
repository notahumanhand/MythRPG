@inject ICharactersRepository CharactersRepository
@inject IClassesRepository ClassesRepository
@inject ITraitsRepository TraitsRepository

@if ((traits is null || traits.Count == 0) && charId > 0)
{
    <p>This character has no traits yet.</p>
}
else if (traits is null || traits.Count == 0)
{
    <p>No traits to display.</p>
}
else 
{
    @foreach (var trait in traits.OrderBy(t => t.Name))
    {
        <div class="border border-dark m-2 p-2 rounded">
            @if (mode == TraitsSpellsDisplayMode.CharacterEdit)
            {
                <div class="row">
                    <div class="col-md-11">
                        <h4>@trait.Name</h4>
                        <br />
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-danger" @onclick="() => Remove(trait)">Remove</button>
                    </div>
                </div>
            }
            else if (mode == TraitsSpellsDisplayMode.ClassEdit)
            {
                <div class="row">
                    <div class="col-md-10">
                        <h4>@trait.Name</h4>
                        <br />
                    </div>

                    <div class="col-md-1">
                        <a class="btn btn-primary"
                           href="/trait/edit/@trait.TraitId">
                            Edit
                        </a>
                    </div>

                    <div class="col-md-1">
                        <button type="button"
                                class="btn btn-danger"
                                @onclick="() => Remove(trait)">
                            Remove
                        </button>
                    </div>
                </div>
            }
            else if (mode == TraitsSpellsDisplayMode.AdminView)
            {
                <div class="row">
                    <div class="col-md-10">
                        <h4>@trait.Name</h4>
                        <br />
                    </div>
                    <div class="col-md-1">
                        <a class="btn btn-primary" href="/trait/edit/@trait.TraitId">Edit</a>
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-danger" @onclick="() => Delete(trait)">Delete</button>
                    </div>
                </div>
            }
            else
            {
                <h4>@trait.Name</h4>
                <br />
            }
            @if (string.Equals(trait.Source, "Class Trait", StringComparison.OrdinalIgnoreCase))
            {
                <h5><b>Class:</b> @ClassDisplay(trait)</h5>
            }
            <div class="row">
                <div class="col-md-4 border border-dark p-2 rounded" style="background: #EEECE5;">
                    <b>Source</b><br>
                    @trait.Source
                </div>
                <div class="col-md-4 border border-dark p-2 rounded" style="background: #EEECE5;">
                    <b>Rank</b><br>
                    @trait.Rank
                </div>
                <div class="col-md-4 border border-dark p-2 rounded" style="background: #EEECE5;">
                    <b>Prerequisites</b><br>
                    None
                </div>
            </div>
            @if (bonuses)
            {
                <h5>Bonuses</h5>
                <ListBonusesComponent bonuses="@trait.Bonuses" showId="false"></ListBonusesComponent>
            }
            <h5>Description</h5>
            <div>
                @MarkdownHelper.ToMarkup(trait.Description)
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public required List<Trait> traits { get; set; }
    [Parameter]
    public int charId { get; set; } = 0;
    [Parameter]
    public int classId { get; set; } = 0;
    [Parameter]
    public required bool bonuses { get; set; }
    [Parameter]
    public required TraitsSpellsDisplayMode mode { get; set; }
    void Remove(Trait trait)
    {
        if (mode == TraitsSpellsDisplayMode.CharacterEdit)
        {
            CharactersRepository.RemoveTrait(
                charId,
                trait.TraitId);
        }
        else if (mode == TraitsSpellsDisplayMode.ClassEdit)
        {
            ClassesRepository.RemoveTraitFromClass(
                classId,
                trait.TraitId);

            traits.Remove(trait);

            StateHasChanged();
        }
    }
    void Delete(Trait trait)
    {
        TraitsRepository.DeleteTrait(trait.TraitId);

        traits.Remove(trait);

        StateHasChanged();
    }
    private string ClassDisplay(Trait trait)
    {
        if (!string.Equals(trait.Source, "Class Trait", StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        if (trait.EligibleClasses.Count == 0)
        {
            return "All";
        }

        return string.Join(", ", trait.EligibleClasses.Select(c => c.Name).OrderBy(n => n));
    }
}