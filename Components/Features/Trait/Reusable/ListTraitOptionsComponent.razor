@inject ITraitsRepository TraitsRepository

<option value="">v Choose Trait v</option>
@foreach (var trait in traits)
{
    <option value="@trait.Name">@trait.Name: @trait.Source</option>
}


@code {
    private List<Trait> traits = new List<Trait>();

    [Parameter]
    public List<Trait>? traitsOverride { get; set; }

    [Parameter]
    public string? type { get; set; }

    protected override void OnParametersSet()
    {
        if (traitsOverride is not null)
        {
            traits = traitsOverride;
        }
        else
        {
            traits = TraitsRepository.GetTraits();
        }

        if (!string.IsNullOrWhiteSpace(type))
        {
            traits = traits
                .Where(t =>
                    !string.IsNullOrWhiteSpace(t.Source) &&
                    t.Source.Contains(
                        type,
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }
}