<div class="d-flex justify-content-around">
    @if (characters is not null && characters.Count > 0)
    {
        foreach (var character in characters)
        {
            <CharacterListItemComponent Character="@character" Mode="@Mode" CurrentUserId="@CurrentUserId" UserNames="@UserNames"></CharacterListItemComponent>
        }
    }
</div>

@code {
    [Parameter]
    public required List<Character> characters { get; set; }
    [Parameter]
    public CharacterDisplayMode Mode { get; set; }
    [Parameter]
    public string? CurrentUserId { get; set; }
    [Parameter]
    public Dictionary<string, string> UserNames
    { get; set; } = new();
}