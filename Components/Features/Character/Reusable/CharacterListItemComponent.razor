@if (this.Character is not null)
{
    <div class="align-items-center border border-dark rounded p-5">
        @if (ShowOwnerName && !string.IsNullOrEmpty(Character.UserId))
        {
            <a href="/@Character.UserId/characters">@UserNames.GetValueOrDefault(Character.UserId, "Unknown")</a>
            <br />
        }
        @if (ShowPortrait)
        {
            <img src="@(Character.PortraitUrl ?? PortraitsRef.Default)" width="100" />
        }
        <h3>@Character.CharacterName</h3>
        <b>
            Level @Character.CharacterLevel
            @Character.Species
            @Character.CharacterClass.Name
        </b>
        <br />
        <a class="btn btn-light" href="/character-sheet/@Character.CharacterId">View</a>
        @if (CanEdit)
        {
        <a class="btn btn-primary" href="/character-sheet/edit/@Character.CharacterId">Edit</a>
        <a class="btn btn-danger" href="/delete/@Character.CharacterId">Delete</a>
        }
    </div>
}

@code {
    [Parameter]
    public Character? Character { get; set; }
    [Parameter]
    public required CharacterDisplayMode Mode { get; set; }
    [Parameter]
    public string? CurrentUserId { get; set; }
    [Parameter]
    public Dictionary<string, string> UserNames
    { get; set; } = new();

    private bool CanEdit =>
    Character is not null &&
    (
        Mode == CharacterDisplayMode.Admin ||
        Mode == CharacterDisplayMode.User ||
        (
            Mode == CharacterDisplayMode.Display &&
            !string.IsNullOrEmpty(CurrentUserId) &&
            Character.UserId == CurrentUserId
        )
    );

    private bool ShowPortrait =>
    Mode switch
    {
        CharacterDisplayMode.Admin => false,
        _ => true
    };

    private bool ShowOwnerName =>
        Mode switch
        {
            CharacterDisplayMode.Display => true,
            CharacterDisplayMode.Admin => true,
            _ => false
        };
}
