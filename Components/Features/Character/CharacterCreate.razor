@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject UserManager<User> UserManager
@inject ICharactersRepository CharactersRepository;
@inject IClassesRepository ClassesRepository;
@inject NavigationManager NavigationManager;

@page "/create-character"

<PageTitle>Mythmaven: Create Character</PageTitle>

@if (PageReady)
{
<h3>Create Character</h3>
<br />

<EditForm Model="character" FormName="formCharacter" OnValidSubmit="Create">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <div class="row">
        <div class="col-md-10">
            <div class="form-group">
                <label for="name">Name</label>
                <InputText id="name" @bind-Value="character.CharacterName" class="form-control"></InputText>
                <ValidationMessage For="() => character.CharacterName"></ValidationMessage>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label for="level">Starting Level</label>
                <InputNumber id="level" @bind-Value="character.CharacterLevel" class="form-control"></InputNumber>
                <ValidationMessage For="() => character.CharacterLevel"></ValidationMessage>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="species">Species</label>
                <InputText id="species" @bind-Value="character.Species" class="form-control"></InputText>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="class">Class</label>
                    <InputSelect @bind-Value="selectedClassId" class="form-control">
                        @foreach (var characterClass in classes)
                        {
                            <option value="@characterClass.CharacterClassId">
                                @characterClass.Name
                            </option>
                        }
                    </InputSelect>
            </div>
        </div>
    </div>
    <br />
    <div class="alert alert-info">
        These details can be changed later!
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a href="/" class="btn btn-primary">Cancel</a>
</EditForm>
@if (error)
{
    <p class="alert alert-danger">Something went wrong. Please refresh the page and try again.</p>
}
}

@code {
    [SupplyParameterFromForm]
    private Character character { get; set; } =  default!;
    private int selectedClassId;
    private List<CharacterClass> classes = new();
    private bool error = false;
    private bool PageReady = false;
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        if (user.IsInRole("Spectator"))
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        classes = ClassesRepository.GetClasses();
        selectedClassId = classes.First().CharacterClassId;

        character = new Character
            {
                UserId = string.Empty,
                CharacterName = string.Empty,
                CharacterClass = classes.First()
            };

        selectedClassId = classes.First().CharacterClassId;

        PageReady = true;
    }
    private async Task Create()
    {
        var authState = await AuthState;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            var selectedClass = ClassesRepository.GetClassById(selectedClassId);
            if (selectedClass is null)
            {
                error = true;
                return;
            }

            if (userId != null)
            {
                character.UserId = userId;
                character.CharacterClass = selectedClass;
                character.Traits = new List<Trait>();
                character.Spells = new List<Spell>();

                CharactersRepository.AddCharacter(character);
                NavigationManager.NavigateTo("/");
            }
        }
        else
        {
            error = true;
        }
    }
}