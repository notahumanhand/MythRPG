@page "/character-sheet/edit/{CharId:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<User> UserManager
@inject NavigationManager NavigationManager
@inject ICharactersRepository CharactersRepository
@inject IClassesRepository ClassesRepository
@inject ITraitsRepository TraitsRepository
@inject ISpellsRepository SpellsRepository

<PageTitle>Mythmaven: Edit Character</PageTitle>

<h2>Edit Character</h2>
@if (PageReady && this.character is not null)
{
    
    <div class="row">
        <div class="col-md-10">
            <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" @bind="character.CharacterName" class="form-control"></input>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label for="level">Level</label>
                <input type="number" min="1" max="20" id="level" @bind="character.CharacterLevel" class="form-control"></input>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="species">Species</label>
                <input type="text" id="species" @bind="character.Species" class="form-control"></input>
            </div>
        </div>
        <div class="col-md-4">
            <label for="portrait">Potrait</label>
            <select id="portrait" @bind="character.PortraitUrl" class="form-control">
                <option value=""></option>
                @foreach (var p in portraits)
                {
                    <option value="@p.Url">@p.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label>Make this character publicly viewable</label>
            <input type="checkbox" @bind="character.IsPublic" /> 
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="class">Class</label>
                <InputSelect id="class" @bind-Value="selectedClassId" class="form-control">
                    @foreach (var characterClass in classes)
                    {
                        <option value="@characterClass.CharacterClassId">
                            @characterClass.Name
                        </option>
                    }
                </InputSelect>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="mythic">Mythic Path</label>
                <select id="mythic" @bind="character.MythicPath" class="form-control">
                    <MythicSelectOptionComponent></MythicSelectOptionComponent>
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label for="might">Might</label>
                <input type="number" min="0" max="5" id="might" @bind="character.Might" class="form-control"></input>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="agility">Agility</label>
                <input type="number" min="0" max="5" id="agility" @bind="character.Agility" class="form-control"></input>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="knowledge">Knowledge</label>
                <input type="number" min="0" max="5" id="knowledge" @bind="character.Knowledge" class="form-control"></input>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="charisma">Charisma</label>
                <input type="number" min="0" max="5" id="charisma" @bind="character.Charisma" class="form-control"></input>
            </div>
        </div>
    </div>
    <br />
    <br />
    <div class="row">
        <div class="col-md-4">
            <label for="size">Size</label><br>
            <select name="size" id="size" class="size fillable" @bind="character.Size">
                <option value="medium">Medium</option>
                <option value="small">Small</option>
                <option value="large">Large</option>
            </select>
        </div>
        <div class="col-md-4">
            <label for="armour">Armour</label><br>
            <select name="armour" id="armour" class="armour fillable" @bind="character.Armour">
                <option value="unarmoured">Unarmoured</option>
                <option value="light-armour">Light Armour</option>
                <option value="medium-armour">Medium Armour</option>
                <option value="heavy-armour">Heavy Armour</option>
                <option value="light-robes">Light Robes</option>
                <option value="medium-robes">Medium Robes</option>
                <option value="heavy-robes">Heavy Robes</option>
                <option value="hybrid-armour">Hybrid Armour</option>
            </select>
        </div>
        <div class="col-md-4">
            <label for="shield">Shield</label><br>
            <input type="checkbox" id="shield" name="shield" value="1" @bind="character.Shield">
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <label for="primary-trait">Primary Trait</label><br>
            <textarea id="primary-trait" name="primary-trait" rows="4" cols="50" class="fillable" @bind="character.PrimaryTrait"></textarea>
        </div>
        <div class="col-md-4">
            <label for="secondary-trait">Secondary Trait</label><br>
            <textarea id="secondary-trait" name="secondary-trait" rows="4" cols="50" class="fillable" @bind="character.SecondaryTrait"></textarea>
        </div>
        <div class="col-md-4">
            <label for="tertiary-trait">Tertiary Trait</label><br>
            <textarea id="tertiary-trait" name="tertiary-trait" rows="4" cols="50" class="fillable" @bind="character.TertiaryTrait"></textarea>
        </div>
    </div>
    <br />
    <br />
    <div class="row">
        <div class="col-md-6">
            <h3>Traits</h3>
            <ListTraitsComponent traits="@character.Traits" charId="@character.CharacterId" bonuses="true" mode="TraitsSpellsDisplayMode.CharacterEdit"></ListTraitsComponent>
            <h4>Add Trait</h4>
            <div class="border border-dark m-2 p-2 rounded">
                <select id="class" @bind="traitselected" class="form-control">
                    <ListTraitOptionsComponent traitsOverride="@availableTraits" type="Class Trait"></ListTraitOptionsComponent>
                </select>
                <button type="button" class="btn btn-primary" @onclick="AddTrait">Add Trait</button>
            </div>
        </div>
        <div class="col-md-6">
            <h3>Spells</h3>
            <b>Your Colours</b>
            @foreach (var colour in character.CharacterClass.SpellColours)
            {
                <span class="badge bg-secondary m-1">
                    @colour.Name
                </span>
            }
            <ListSpellsComponent spells="@character.Spells" charId="@character.CharacterId" mode="TraitsSpellsDisplayMode.CharacterEdit"></ListSpellsComponent>
            <h4>Add Spell</h4>
            <div class="border border-dark m-2 p-2 rounded">
                <select id="class" @bind="spellselected" class="form-control">
                    <ListSpellOptionsComponent AllowedColours="@character.CharacterClass.SpellColours"></ListSpellOptionsComponent>
                </select>
                <button type="button" class="btn btn-primary" @onclick="AddSpell">Add Spell</button>
            </div>
        </div>
    </div>
    
    @if (confirmText)
    {
        <p class="alert alert-success">Changes saved! <button type="button" class="btn btn-danger" @onclick="ClearAlert">X</button></p>
    }
    <button type="button" class="btn btn-success" @onclick="Update">Save Changes</button>
    <a href="/character-sheet/@CharId" class="btn btn-primary">View Character Sheet</a>
    <a href="/" class="btn btn-primary">Return to Home</a>
    <a class="btn btn-danger" href="/delete/@CharId">Delete Character</a>
}

@code {
    private readonly List<(string Name, string Url)> portraits = PortraitsRef.All;

    [Parameter]
    public int CharId { get; set; }

    private Character? character;
    private List<Spell> spells = new();

    private List<CharacterClass> classes = new();
    private int selectedClassId;

    private List<Trait> availableTraits = new();

    private bool confirmText = false;
    private bool AuthorizedEditor = false;
    private bool PageReady = false;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var currentUser =
            await UserManager.GetUserAsync(authState.User);

        if (currentUser == null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        character = CharactersRepository.GetCharacterById(CharId);

        if (character is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        bool isAdmin = await UserManager.IsInRoleAsync(currentUser, "Admin");

        bool isOwner = character.UserId == currentUser.Id;

        AuthorizedEditor = isOwner || isAdmin;

        if (!AuthorizedEditor)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        classes = ClassesRepository.GetClasses();
        selectedClassId = character.CharacterClass.CharacterClassId;
        RefreshAvailableTraits();

        PageReady = true;
    }

    void Update()
    {
        if (!AuthorizedEditor)
        {
            return;
        }
        var selectedClass = ClassesRepository.GetClassById(selectedClassId);

        if (selectedClass is not null)
        {
            character.CharacterClass = selectedClass;
        }
        CharactersRepository.UpdateCharacter(CharId, character);
        confirmText = true;
        character = CharactersRepository.GetCharacterById(CharId);
        RefreshAvailableTraits();
    }
    void ClearAlert()
    {
        if (!AuthorizedEditor)
        {
            return;
        }
        confirmText = false;
    }
    private string traitselected = "";
    private bool confirmTraitText = false;
    void AddTrait()
    {
        if (!AuthorizedEditor)
        {
            return;
        }
        if (!String.IsNullOrWhiteSpace(traitselected))
        {
            Trait? traitToAdd = TraitsRepository.GetTraitByName(traitselected);
            if (traitToAdd is not null && character is not null) TraitsRepository.AddTraitToCharacter(character.CharacterId, traitToAdd);
            traitselected = "";
            confirmTraitText = true;
            character = CharactersRepository.GetCharacterById(CharId);
            RefreshAvailableTraits();
        }
    }
    private string spellselected = "";
    private bool confirmSpellText = false;
    void AddSpell()
    {
        if (!AuthorizedEditor)
        {
            return;
        }
        if (!String.IsNullOrWhiteSpace(spellselected))
        {
            Spell? spellToAdd = SpellsRepository.GetSpellByName(spellselected);
            if (character is not null && spellToAdd is not null) SpellsRepository.AddSpellToCharacter(character.CharacterId, spellToAdd);
            spellselected = "";
            confirmSpellText = true;
            character = CharactersRepository.GetCharacterById(CharId);
        }
    }
    private void RefreshAvailableTraits()
    {
        if (character is null)
        {
            return;
        }

        availableTraits = TraitsRepository.GetAvailableTraitsForClass(character.CharacterClass.CharacterClassId)
                .Where(t => !character.Traits.Any(ct => ct.TraitId == t.TraitId))
                .ToList();
    }

}
