@page "/class/{ClassId:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject IClassesRepository ClassesRepository

<PageTitle>Mythmaven: @characterClass.Name</PageTitle>

@if (characterClass is not null)
{
    <div class="row">
        <div class="col-md-10">
            <h3>@characterClass.Name</h3>
        </div>
        <div class="col-md-2">
            <a class="btn btn-primary"
               href="/classes">
                Return to Classes
            </a>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a class="btn btn-primary"
                       href="/class/edit/@characterClass.CharacterClassId">
                        Edit Class
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <div class="border border-dark m-2 p-2 rounded">
        <h5>Description</h5>
        <div>
            @MarkdownHelper.ToMarkup(characterClass.Description)
        </div>
    </div>
    
    <div class="border border-dark m-2 p-2 rounded">
    <h5>Primary Bonus</h5>
        <p>If you chose @characterClass.Name as your class at first level, you gain the following benefit:</p>
        <p>@characterClass.PrimaryBonus</p>
    </div>
    
    <div class="border border-dark m-2 p-2 rounded">
        <h5>Spell Progression</h5>
        <p>@SpellProgressionText()</p>
        <h5>Spell Lists</h5>
        <p>@SpellListsText()</p>
    </div>

    <h4>Granted Traits</h4>
    <ListTraitsComponent traits="characterClass.GrantedTraits" bonuses="true" mode="TraitsSpellsDisplayMode.Display"></ListTraitsComponent>
}

@code {
    [Parameter]
    public int ClassId { get; set; }

    private CharacterClass characterClass = new();

    protected override void OnParametersSet()
    {
        characterClass = ClassesRepository.GetClassById(ClassId);
    }

    private string SpellProgressionText()
    {
        string startingSpellText =
            characterClass.StartingSpells == 1
                ? "spell"
                : "spells";

        string perLevelSpellText =
            characterClass.SpellsPerLevel == 1
                ? "spell"
                : "spells";

        return
            $"Starts with {characterClass.StartingSpells} {startingSpellText} and gains {characterClass.SpellsPerLevel} {perLevelSpellText} per level.";
    }

    private string SpellListsText()
    {
        var colours =
            characterClass.SpellColours
                .Select(c => c.Name)
                .ToList();

        if (colours.Count == 0)
        {
            return "None";
        }

        if (colours.Count == 1)
        {
            return colours[0];
        }

        if (colours.Count == 2)
        {
            return $"{colours[0]} and {colours[1]}";
        }

        return
            $"{string.Join(", ", colours.Take(colours.Count - 1))}, and {colours.Last()}";
    }
}