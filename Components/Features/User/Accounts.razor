@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IUsersRepository UsersRepository
@inject UserManager<User> UserManager
@attribute [Authorize(Roles = "Admin")]
@page "/accounts"
@rendermode InteractiveServer

<AuthorizeView Roles="Admin">
    <Authorized>

    <h3>Accounts</h3>
    <table class="table bg-transparent">
        <thead class="bg-transparent">
            <tr>
                <th scope="col" class="bg-transparent">Id</th>
                <th scope="col" class="bg-transparent">Username</th>
                <th scope="col" class="bg-transparent">Roles</th>
                <th scope="col" class="bg-transparent">Characters</th>
                <th scope="col" class="bg-transparent">Collection</th>
                <th scope="col" class="bg-transparent"></th>
                <th scope="col" class="bg-transparent"></th>
            </tr>
        </thead>
        <tbody class="bg-transparent">
            @foreach (var user in users)
            {
                <tr>
                    <th scope="row" class="bg-transparent">@user.Id</th>
                    <td class="bg-transparent">@user.UserName</td>
                    <td class="bg-transparent">
                            @if (userRoles.TryGetValue(user.Id, out var roles) && roles.Count > 0)
                            {
                                @foreach (var role in roles)
                                {
                                    <span class="badge bg-secondary me-1">
                                        @role
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">None</span>
                            }
                    </td>
                    <td class="bg-transparent">
                        @string.Join(", ", user.Characters.Select(c => c.CharacterName))
                    </td>
                    <td class="bg-transparent">
                            @if (!userRoles.GetValueOrDefault(user.Id, new List<string>()).Contains("Spectator"))
                            {
                                <a class="btn btn-secondary" href="/@user.Id/characters">
                                    View
                                </a>
                            }
                    </td>
                    <td class="bg-transparent">
                        <a class="btn btn-primary" href="/manage/@user.Id">Edit</a>
                    </td>
                    <td class="bg-transparent">
                        <button type="button" class="btn btn-danger" @onclick="() => DeleteUser(user.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </Authorized>
    <NotAuthorized>
        <p>You are not authorized to view this page.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    public List<User> users = new List<User>();
    private User newuser = new User { UserName = "" };
    private string text = "";
    private Dictionary<string, IList<string>> userRoles = new();
    protected override async Task OnInitializedAsync()
    {
        users = UsersRepository.GetUsers();

        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            userRoles[user.Id] = roles;
        }
    }
    private async Task DeleteUser(string id)
    {
        var user = await UserManager.FindByIdAsync(id);
        if (user != null)
        {
            await UserManager.DeleteAsync(user);
            users = UsersRepository.GetUsers();
        }
    }
    private void Clear()
    {
        newuser.UserName = "";
        text = "";
    }
}
