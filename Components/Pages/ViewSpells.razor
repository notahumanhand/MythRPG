@page "/spells"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject ISpellsRepository SpellsRepository

<h3>Spells</h3>
<AuthorizeView Roles="Admin" Context="adminContext">
    <Authorized>
        <ListSpellsComponent spells="spells" mode="TraitsSpellsDisplayMode.AdminView"></ListSpellsComponent>
    <h4>Add Spell</h4>
    <div class="border border-dark m-2 p-2 rounded">
        <EditForm Model="spell" FormName="formSpell" OnValidSubmit="Create">
            <DataAnnotationsValidator></DataAnnotationsValidator>
            <div class="form-group">
                <label for="name">Name</label>
                <InputText id="name" @bind-Value="spell.Name" class="form-control"></InputText>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="cost">Arcana Cost</label>
                            <InputNumber id="cost" min="0" max="20" @bind-Value="spell.Cost" class="form-control"></InputNumber>
                        <ValidationMessage For="() => spell.Cost"></ValidationMessage>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="casting">Casting Time</label>
                            <InputSelect id="casting" @bind-Value="spell.Casting" class="form-control">
                                <option>Basic Action</option>
                                <option>Swift Action</option>
                            </InputSelect>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="colour">Colour</label>
                            <InputSelect id="colour" @bind-Value="spell.Colour" class="form-control">
                                <option>Black</option>
                                <option>White</option>
                                <option>Red</option>
                                <option>Orange</option>
                                <option>Gold</option>
                                <option>Green</option>
                                <option>Blue</option>
                                <option>Purple</option>
                                <option>Brown</option>
                            </InputSelect>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="type">Type</label>
                            <InputSelect id="type" @bind-Value="spell.Type" class="form-control">
                                <option>Attack</option>
                                <option>Buff</option>
                                <option>Control</option>
                                <option>Creation</option>
                                <option>Debuff</option>
                                <option>Detection</option>
                                <option>Healing</option>
                                <option>Illusion</option>
                                <option>Protection</option>
                                <option>Teleportation</option>
                                <option>Utility</option>
                            </InputSelect>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="form-group">
                        <label for="duration">Duration</label>
                            <InputSelect id="duration" @bind-Value="spell.Duration" class="form-control">
                                <option>Instant</option>
                                <option>Turn</option>
                                <option>Round</option>
                                <option>Encounter</option>
                                <option>Day</option>
                                <option>Indefinite</option>
                            </InputSelect>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-group">
                        <label for="range">Range</label>
                            <InputSelect id="range" @bind-Value="spell.Range" class="form-control">
                                <option>Self</option>
                                <option>Melee</option>
                                <option>Close</option>
                                <option>Short</option>
                                <option>Long</option>
                                <option>Extreme</option>
                                <option>Absurd</option>
                                <option>N/A</option>
                            </InputSelect>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label for="type">Concentration</label>
                        <br />
                        <InputCheckbox id="type" @bind-Value="spell.Concentration"></InputCheckbox>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label for="description">Description</label>
                <InputTextArea id="description" @bind-Value="spell.Effect" class="form-control"></InputTextArea>
            </div>
            <br />
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
        <br />
        <br />
        <h4>@spell.Name</h4>
        <div class="row">
            <div class="col-md-1">
                <b>Arcana Cost</b><br>
                @spell.Cost
            </div>
            <div class="col-md-2">
                <b>Casting Time</b><br>
                @spell.Casting
            </div>
            <div class="col-md-2">
                <b>Colour</b><br>
                @spell.Colour
            </div>
            <div class="col-md-2">
                <b>Type</b><br>
                @spell.Type
            </div>
            <div class="col-md-2">
                <b>Duration</b><br>
                @spell.Duration
            </div>
            <div class="col-md-2">
                <b>Range</b><br>
                @spell.Range
            </div>
            @if (spell.Concentration is true)
            {
                <div class="col-md-1">
                    <b>Concentration</b>
                </div>
            }
        </div>
        <h5>Effect</h5>
        <p>@spell.Effect</p>
    </div>
    </Authorized>
    <NotAuthorized>
        <ListSpellsComponent spells="spells" mode="TraitsSpellsDisplayMode.Display"></ListSpellsComponent>
    </NotAuthorized>
</AuthorizeView>

@code {
    [SupplyParameterFromForm]
    private Spell spell { get; set; } = new Spell();

    List<Spell> spells = new List<Spell>();
    protected override void OnParametersSet()
    {
        spells = SpellsRepository.GetSpells();
    }
    private void Create()
    {
        SpellsRepository.AddSpell(spell);
        spell = new Spell();
        spells = SpellsRepository.GetSpells();
    }
}
